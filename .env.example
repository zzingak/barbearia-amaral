# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA envie o arquivo .env para ninguém nem para a internet.

# Banco de dados. No seu computador usamos SQLite (um arquivo simples).
DATABASE_URL="file:./dev.db"

# Login do painel administrativo (usado ao criar os dados iniciais).
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha-123"

# Texto longo e aleatório, usado para proteger o login. Troque por outro.
SESSION_SECRET="troque-por-um-texto-longo-e-aleatorio-com-mais-de-32-caracteres"

# Endereço do site (no computador local):
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
